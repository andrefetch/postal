    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/marked-terminal": "6.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }

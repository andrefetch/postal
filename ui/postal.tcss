Screen {
    background: #101010;
    color: #dedede;
    align-horizontal: center;
}
#shell {
    width: 100%;
    max-width: 112;
    height: 100%;
    padding: 1 3;
}
#topbar { height: 1; margin-bottom: 1; }
#brand { width: 9; color: #dedede; text-style: bold; }
#workspace { width: 1fr; text-align: right; color: #737373; height: 1; }
#main { height: 1fr; align-horizontal: center; }
#prompt-area { height: auto; }
#main.home #prompt-area, #main.home #welcome, #main.home #home-spacer { max-width: 72; }
#main.home #conversation { display: none; }
#home-spacer { display: none; height: 1fr; }
#main.home #home-spacer { display: block; }
#conversation {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #3a3a3a;
    scrollbar-color-hover: #626262;
    scrollbar-color-active: #858585;
    scrollbar-background: #101010;
    padding-right: 1;
}
#welcome {
    height: 1fr;
    min-height: 8;
    align: center bottom;
}
#cloud-logo { width: 16; height: 3; }
#cloud-row { height: 3; }
#wordmark { height: 1; margin-top: 1; text-align: center; }
#welcome-hint { height: 1; margin: 1 0; color: #858585; text-align: center; }
.message { height: auto; margin: 1 0; }
.message-label { height: 1; color: #7c7c7c; margin-bottom: 1; }
.message-body { height: auto; color: #dedede; }
.user { border-left: solid #474747; padding-left: 2; }
.user .message-label { color: #b8b8b8; }
.notice { height: auto; color: #a8a8a8; margin: 1 0; }
#composer-box { height: auto; background: #27272a; border: round #45454a; padding: 0 2; margin-top: 1; }
#composer-box:focus-within { border: round #797383; }
#main.home #composer-box { margin-top: 0; }
#composer {
    height: 3;
    min-height: 3;
    max-height: 6;
    padding: 1 0 0 0;
    border: none;
    background: #27272a;
    color: #f5f5f5;
    scrollbar-size: 1 1;
}
#composer:focus { border: none; }
#composer .text-area--cursor { background: #b39dff; color: #27272a; }
#composer .text-area--selection { background: #514760; }
#composer .text-area--placeholder { color: #a1a1aa; }
#prompt-toolbar, #prompt-sources { height: 1; }
#prompt-spacer { width: 1fr; }
#composer-box Button {
    height: 1;
    min-width: 3;
    width: auto;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #27272a;
    color: #d4d4d8;
    text-style: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#composer-box Button:hover, #composer-box Button:focus { background: #3f3f46; color: #f5f5f5; }
#composer-box Button.-active { background: #55505e; }
#composer-box Button:disabled { color: #71717a; background: #27272a; opacity: 100%; }
#composer-box #prompt-add { width: 3; color: #f5f5f5; }
#composer-box #prompt-model { max-width: 28; min-width: 8; }
#composer-box #prompt-effort { max-width: 11; margin-left: 1; }
#composer-box #prompt-send { width: 3; margin-left: 1; background: #b39dff; color: #242126; text-style: bold; }
#composer-box #prompt-send:disabled { background: #3f3f46; color: #a1a1aa; }
#composer-box #prompt-send:hover, #composer-box #prompt-send:focus { background: #d3c6ff; color: #242126; }
#composer-box #prompt-send.busy { background: #f5f5f5; color: #27272a; }
#composer-box #file-chip, #composer-box #web-chip { max-width: 50%; margin-right: 1; background: #3c3747; color: #d9ccff; }
#shell.narrow #composer-box { padding: 0 1; }
#shell.narrow #prompt-model { width: 1fr; }
#statusbar { height: 1; margin-top: 1; }
#run-status { width: 1fr; height: 1; color: #929292; }
#key-hints { width: auto; max-width: 48; height: 1; text-align: right; color: #686868; }
#shell.narrow { padding: 1; }
#shell.short #welcome { min-height: 5; }
#shell.short #welcome-hint { display: none; }
#shell.short #wordmark { margin-bottom: 1; margin-top: 0; }
#shell.short #commands { max-height: 4; }
#shell.compact { padding: 0 1; }
#shell.compact #topbar, #shell.compact #wordmark { display: none; }
#shell.compact #welcome { min-height: 3; }
#shell.compact #commands { max-height: 3; }
#main.home.commands-open #welcome { min-height: 0; visibility: hidden; }
#commands {
    height: auto;
    max-height: 8;
    background: #323236;
    border: none;
    padding: 0 1;
    color: #bcbcbc;
}
OptionList > .option-list--option-highlighted { background: #49434f; color: #f5f5f5; }
OptionList:focus > .option-list--option-highlighted { background: #49434f; color: #f5f5f5; }
PromptPicker { align: center middle; background: #101010 60%; }
#picker-dialog { width: 64; max-width: 90%; height: auto; max-height: 90%; padding: 1 2; background: #323236; border: round #625a70; }
#picker-title { height: 1; margin-bottom: 1; color: #f5f5f5; text-style: bold; }
#picker-input { height: 3; margin-bottom: 1; background: #27272a; border: round #797383; color: #f5f5f5; }
#picker-input:focus { border: round #b39dff; }
#picker-options { height: auto; max-height: 6; border: none; padding: 0; background: #323236; color: #f5f5f5; }
#picker-hint { height: 1; margin-top: 1; color: #a1a1aa; }
#picker-error { height: auto; color: #e4c5c5; }
PromptPicker.compact #picker-dialog { padding: 0 1; }
PromptPicker.compact #picker-title, PromptPicker.compact #picker-input { margin-bottom: 0; }
PromptPicker.compact #picker-options { max-height: 3; }
.tool-block, .reasoning-block {
    border: none;
    padding: 0;
    margin: 0;
    background: #101010;
    color: #999999;
}
Collapsible > CollapsibleTitle { padding: 0; color: #999999; background: #101010; }
Collapsible > CollapsibleTitle:hover { color: #dedede; background: #1c1c1c; }
Collapsible > CollapsibleTitle:focus { background: #282828; color: #eeeeee; }
Collapsible > Contents { padding: 1 2; background: #151515; }
.tool-details { color: #a9a9a9; height: auto; }
ApprovalScreen, AgentsScreen { align: center middle; background: #000000 65%; }
.dialog { width: 90%; max-width: 100; height: 85%; background: #181818; border: solid #5a5a5a; padding: 1 2; }
.dialog-title { height: 1; text-style: bold; color: #eeeeee; margin-bottom: 1; }
.dialog-hint { height: auto; color: #808080; margin-top: 1; }
#approval-description { height: auto; margin-bottom: 1; }
#approval-content { height: 1fr; scrollbar-size: 1 1; }
#approval-body { height: auto; color: #c2c2c2; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
Button { min-width: 16; height: 3; border: none; background: #2b2b2b; color: #c9c9c9; margin-left: 1; }
Button:hover { background: #3b3b3b; }
Button:focus { background: #d4d4d4; color: #101010; text-style: bold; }
#agents-tree { height: 1fr; background: #181818; color: #c0c0c0; scrollbar-size: 1 1; }
#agents-tree > .tree--cursor { background: #393939; color: #eeeeee; text-style: bold; }
#agent-detail-scroll { height: 1fr; border-top: solid #373737; padding-top: 1; scrollbar-size: 1 1; }
#agent-details { height: auto; color: #aaaaaa; }

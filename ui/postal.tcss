Screen {
    background: #101010;
    color: #dedede;
    align-horizontal: center;
}
#shell {
    width: 100%;
    max-width: 112;
    height: 100%;
    padding: 1 3 0 3;
}
#topbar { height: 1; margin-bottom: 1; }
#brand { width: 9; color: #dedede; text-style: bold; }
#workspace { width: 1fr; text-align: right; color: #737373; height: 1; }
#conversation {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #3a3a3a;
    scrollbar-color-hover: #626262;
    scrollbar-color-active: #858585;
    scrollbar-background: #101010;
    padding-right: 1;
}
#welcome {
    height: 1fr;
    min-height: 9;
    content-align: center middle;
    text-align: center;
}
.message { height: auto; margin: 1 0; }
.message-label { height: 1; color: #7c7c7c; margin-bottom: 1; }
.message-body { height: auto; color: #dedede; }
.user { border-left: solid #474747; padding-left: 2; }
.user .message-label { color: #b8b8b8; }
.notice { height: auto; color: #a8a8a8; margin: 1 0; }
#composer-box { height: auto; background: #191919; border-left: solid #898989; padding: 0 1; margin-top: 1; }
#composer {
    height: 3;
    min-height: 3;
    max-height: 8;
    padding: 0 0;
    border: none;
    background: #191919;
    color: #e2e2e2;
}
#composer:focus { border: none; }
#composer .text-area--cursor { background: #dedede; color: #101010; }
#composer .text-area--selection { background: #464646; }
#composer .text-area--placeholder { color: #767676; }
#model-line { height: 1; color: #858585; margin-bottom: 1; }
#statusbar { height: 2; padding-top: 0; }
#run-status { width: 1fr; height: 1; color: #929292; }
#key-hints { width: auto; max-width: 48; height: 1; text-align: right; color: #686868; }
#commands {
    height: auto;
    max-height: 8;
    background: #202020;
    border: none;
    padding: 0 1;
    color: #bcbcbc;
}
OptionList > .option-list--option-highlighted { background: #383838; color: #eeeeee; }
OptionList:focus > .option-list--option-highlighted { background: #383838; color: #eeeeee; }
.tool-block, .reasoning-block {
    border: none;
    padding: 0;
    margin: 0;
    background: #101010;
    color: #999999;
}
Collapsible > CollapsibleTitle { padding: 0; color: #999999; background: #101010; }
Collapsible > CollapsibleTitle:hover { color: #dedede; background: #1c1c1c; }
Collapsible > CollapsibleTitle:focus { background: #282828; color: #eeeeee; }
Collapsible > Contents { padding: 1 2; background: #151515; }
.tool-details { color: #a9a9a9; height: auto; }
ApprovalScreen, AgentsScreen { align: center middle; background: #000000 65%; }
.dialog { width: 90%; max-width: 100; height: 85%; background: #181818; border: solid #5a5a5a; padding: 1 2; }
.dialog-title { height: 1; text-style: bold; color: #eeeeee; margin-bottom: 1; }
.dialog-hint { height: auto; color: #808080; margin-top: 1; }
#approval-description { height: auto; margin-bottom: 1; }
#approval-content { height: 1fr; scrollbar-size: 1 1; }
#approval-body { height: auto; color: #c2c2c2; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
Button { min-width: 16; height: 3; border: none; background: #2b2b2b; color: #c9c9c9; margin-left: 1; }
Button:hover { background: #3b3b3b; }
Button:focus { background: #d4d4d4; color: #101010; text-style: bold; }
#agents-tree { height: 1fr; background: #181818; color: #c0c0c0; scrollbar-size: 1 1; }
#agents-tree > .tree--cursor { background: #393939; color: #eeeeee; text-style: bold; }
#agent-detail-scroll { height: 1fr; border-top: solid #373737; padding-top: 1; scrollbar-size: 1 1; }
#agent-details { height: auto; color: #aaaaaa; }
